{
  "name": "castrovalva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vanilla Design System with Web Components",
  "author": "Carl",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./button": {
      "import": "./dist/button.js"
    },
    "./icon": {
      "import": "./dist/icon.js"
    },
    "./css": "./dist/css/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:search": "node scripts/build-search-index.mjs",
    "test": "web-test-runner --node-resolve",
    "test:watch": "npm run test -- --watch",
    "test:all": "web-test-runner --node-resolve --config web-test-runner.full.config.js",
    "test:a11y": "playwright test test/accessibility",
    "test:visual": "playwright test --config playwright.visual.config.js",
    "test:visual:update": "playwright test --config playwright.visual.config.js --update-snapshots",
    "lint": "eslint \"src/**/*.js\"",
    "check:docs": "node scripts/check-api-docs.mjs",
    "lint:fix": "eslint \"src/**/*.js\" --fix"
  },
  "keywords": [
    "design-system",
    "web-components",
    "vanilla",
    "ui-components"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.12.0",
    "playwright": "^1.57.0",
    "terser": "^5.51.2",
    "vite": "^8.3.1"
  }
}
